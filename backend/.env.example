NODE_ENV=development
PORT=3000
# Strict CORS allowlist — comma-separated absolute origins, never a wildcard.
# localhost and 127.0.0.1 are separate origins to a browser, and Vite auto-
# increments to the next free port when 5173 is already taken (e.g. two dev
# servers running), so both loopback hosts on both dev ports are listed.
# Any origin not named here is blocked by the browser with no HTTP status.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Supabase — required for Phase 2
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SECRET_KEY=your-service-role-key

# Gemini — Phase 3A
# Note: gemini-2.5-flash was deprecated (404 for new users); use gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Tavily — Phase 3B
TAVILY_API_KEY=

# Model Studio — optional (legacy plan)
DASHSCOPE_API_KEY=
MODEL_STUDIO_BASE_URL=
MODEL_STUDIO_PRIMARY_MODEL=
MODEL_STUDIO_FAST_MODEL=
