NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Supabase — required for Phase 2
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SECRET_KEY=your-service-role-key

# Gemini — Phase 3A
# Note: gemini-2.5-flash was deprecated (404 for new users); use gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Tavily — Phase 3B
TAVILY_API_KEY=

# Model Studio — optional (legacy plan)
DASHSCOPE_API_KEY=
MODEL_STUDIO_BASE_URL=
MODEL_STUDIO_PRIMARY_MODEL=
MODEL_STUDIO_FAST_MODEL=
