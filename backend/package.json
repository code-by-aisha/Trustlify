{
  "name": "trustlify-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:gemini": "tsx src/scripts/geminiSmokeTest.ts",
    "smoke:tavily": "tsx src/scripts/tavilySmokeTest.ts",
    "smoke:investigation": "tsx src/scripts/investigationMiniSmokeTest.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "multer": "^2.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.21",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vitest": "^2.1.0"
  }
}
