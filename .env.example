# ─── TRUSTLIFY FRONTEND ENVIRONMENT VARIABLES ──────────────────────────────
# Copy this file to .env and fill in the values for local development.
#
# Vite reads these at BUILD time and inlines them into the JavaScript, so the
# same names must also be present in the deployment's build environment (then
# rebuilt) - variables added only to the running app never reach the bundle.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_API_BASE_URL=http://localhost:3000
# Production value is the backend origin without a trailing slash,
# e.g. https://<app>.<region>.suga.run
