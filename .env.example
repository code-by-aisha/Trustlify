# ─── TRUSTLIFY ENVIRONMENT VARIABLES ─────────────────────────────────────────
# Copy this file to .env and fill in the values for local development.

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/trustlify

# AI Provider (openai | anthropic | self-hosted)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o

# Auth
JWT_SECRET=replace-with-random-string-in-production

# Redis (caching + rate limiting)
REDIS_URL=redis://localhost:6379

# File Storage
STORAGE_PATH=./uploads

# Frontend (for CORS)
FRONTEND_URL=http://localhost:5173
